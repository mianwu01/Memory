{
  "task_name": "travel_planner",
  "agent": {
    "model_name": "deepseek-v4-flash",
    "backend": "openai",
    "api_key": "",
    "base_url": "https://api.deepseek.com/v1",
    "_api_key_note": "read from $OPENAI_API_KEY; never commit a key here"
  },
  "memory": {
    "use_step_memory": false,
    "memory_system_name": "causal-learned-pure-inherit",
    "server_url": "http://127.0.0.1:8123",
    "learned_graph_path": "results/real/travel_learned_graph_holdout_101_110.json"
  },
  "env": {
    "env_name": "travel_planner",
    "env_server_url": "http://127.0.0.1:8001",
    "env_config": {"judgement_mode": "none"}
  },
  "task_specific": {
    "max_steps": 12,
    "inherit_unspecified_from_base": true
  },
  "output": {
    "output_dir": "results/travel_e2e/causal-learned-pure-inherit-holdout",
    "log_dir": "results/travel_e2e/logs",
    "global_csv": "results/travel_e2e/results_causal-learned-pure-inherit-holdout.csv"
  }
}
